# Copy to .env (gitignored) and adjust. Nothing here is a secret — devpassword
# only appears in docker-compose.dev.yml's local dev containers.

KR_ENV=dev

# graph: fixture | postgres (default) | neo4j
# standards: fixture | postgres (default)
# retrieval: fixture (default) | live
#
# postgres is the default graph backend, not neo4j: integration Stage A/B
# found no real Neo4j data anywhere and no evidence anything has ever
# written to it — the real relationship data lives in Postgres's
# standard_relationships table. neo4j stays selectable for whenever
# Teammate 1 populates it for real. See INTEGRATION.md.
KR_GRAPH_BACKEND=postgres
KR_STANDARDS_BACKEND=postgres
KR_RETRIEVAL_BACKEND=fixture

# Only read when the corresponding *_BACKEND above needs them. Ports match
# docker-compose.dev.yml's non-default mapping.
KR_NEO4J_URI=bolt://localhost:7688
KR_NEO4J_USER=neo4j
KR_NEO4J_PASSWORD=devpassword
KR_POSTGRES_DSN=postgresql://postgres:devpassword@localhost:5433/kr_dev
KR_RETRIEVAL_BASE_URL=http://localhost:8002

# Path to a schema_map.yaml override; leave unset to use config/schema_map.py's
# defaults.
KR_SCHEMA_MAP_PATH=

# See loader/fixture_loader.py — refuses to write verified=false records
# when KR_ENV=production unless this is explicitly true. Never set this to
# true outside a deliberate, one-off override.
KR_ALLOW_UNVERIFIED_IN_PRODUCTION=false
