# Virtual environment
.venv/
venv/
env/

# Python bytecode / tooling
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg-info/
*.egg
.eggs/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Distribution / packaging
dist/
build/

# Node (for teammates' frontend/extension work)
node_modules/

# Derived / build artifacts (regenerated by ingest.py)
data/derived/standards.db
data/derived/graph.json
data/derived/keyword-index.json

# Env / secrets
.env
.env.*
!.env.example

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# Docker volumes / local data
**/docker-volumes/
postgres_data/
neo4j_data/
qdrant_data/

# Presentation working notes, not part of the build
ppt_plan.md
*.pptx

# Runtime artifacts, written by the running service rather than authored.
# query_logs.jsonl is the append-only search log the /stats endpoint counts;
# it is per-deployment data, not source.
standards-retrieval/data/query_logs.jsonl
*.log

# Local rollback copies and process ids written by data/run_full_ingest.ps1
data/archive/backup/
*.pid
